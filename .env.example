# Environment & Server
NODE_ENV=development
PORT=3000

# PostgreSQL Database (AWS RDS / Local / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_hrms_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/erp_hrms_db?schema=public"

# Multi-Tenant JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-123456"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production-654321"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 Storage
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="mock_aws_access_key"
AWS_SECRET_ACCESS_KEY="mock_aws_secret_key"
AWS_S3_BUCKET_NAME="erp-hrms-documents"

# External Provider Adapters (Modes: 'mock' | 'decentro' / 'cashfree' / 'msg91')
KYC_MODE="mock"
DECENTRO_BASE_URL="https://in.staging.decentro.tech"
DECENTRO_CLIENT_ID="mock_decentro_client_id"
DECENTRO_CLIENT_SECRET="mock_decentro_client_secret"
DECENTRO_MODULE_SECRET="mock_decentro_module_secret"
DECENTRO_WEBHOOK_SECRET="mock_decentro_webhook_secret"

PAYMENT_MODE="mock"
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_APP_ID="mock_cashfree_app_id"
CASHFREE_SECRET_KEY="mock_cashfree_secret_key"
CASHFREE_WEBHOOK_SECRET="mock_cashfree_webhook_secret"

SMS_MODE="mock"
MSG91_AUTH_KEY="mock_msg91_auth_key"
MSG91_SENDER_ID="SALBOX"
MSG91_DLT_TE_ID="mock_dlt_template_id"

GEO_MODE="native_haversine"
